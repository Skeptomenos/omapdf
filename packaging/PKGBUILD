# Maintainer: Peter Bergin
pkgname=omapdf
pkgver=0.1.0
pkgrel=1
pkgdesc="Agent-native PDF annotation and signing for Linux"
arch=('any')
url="https://github.com/pbergin11/omapdf"
license=('AGPL-3.0-or-later')
depends=('python' 'python-pymupdf')
optdepends=(
  'python-mcp: MCP server for AI agents (omapdf-mcp)'
  'omarchy: bar widget and menu-based PDF picker'
)
makedepends=('python-build' 'python-installer' 'python-hatchling')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')  # pin on first tagged release

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm755 bin/omapdf-pick "$pkgdir/usr/bin/omapdf-pick"
  install -Dm644 share/omapdf.desktop "$pkgdir/usr/share/applications/omapdf.desktop"

  # Omarchy bar widget, discoverable for manual linking into
  # ~/.config/omarchy/plugins/
  install -d "$pkgdir/usr/share/omapdf"
  cp -r shell-plugin "$pkgdir/usr/share/omapdf/shell-plugin"
  cp -r skill "$pkgdir/usr/share/omapdf/skill"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
