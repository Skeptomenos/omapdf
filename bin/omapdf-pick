#!/bin/bash
# Pick a PDF from the usual folders (recent first) and open it.
# Used by the omapdf Omarchy bar widget; works standalone too.

set -euo pipefail

dirs="${OMAPDF_PICK_DIRS:-$HOME/Downloads:$HOME/Documents:$HOME/Desktop}"

# Only offer directories that exist — omarchy-menu-file errors on missing paths.
existing=""
IFS=':' read -ra parts <<<"$dirs"
for d in "${parts[@]}"; do
  [[ -d $d ]] && existing="${existing:+$existing:}$d"
done
[[ -n $existing ]] || { notify-send "omapdf" "No PDF folders found"; exit 1; }

choice="$(omarchy menu file "Open PDF" "$existing" "pdf")" || exit 0
[[ -n $choice ]] || exit 0

if command -v omapdf >/dev/null 2>&1; then
  exec omapdf open "$choice"
else
  exec xdg-open "$choice"
fi
